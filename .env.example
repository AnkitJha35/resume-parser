# Resume Parser Service Configuration Template

# Server Port & Workers
PORT=8000
WORKERS=1

# Semantic LLM Provider: 'gemini' | 'openrouter' | 'nvidia' | 'ollama'
SEMANTIC_PROVIDER=gemini

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=30.0
GEMINI_MAX_RETRIES=2

# OpenRouter Configuration (Optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_TIMEOUT=60.0

# NVIDIA NIM Configuration (Optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT=60.0

# Ollama Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120.0

# Upload Limits & OCR
MAX_UPLOAD_SIZE=10485760
OCR_ENABLED=true
OCR_ENGINE=pymupdf

# Kafka & MinIO (Disabled by default for standalone HTTP deployment)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=resumes
